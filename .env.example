TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
USER_WHATSAPP_TO=whatsapp:+910000000000
TWILIO_CONTENT_SID=your-twilio-content-sid

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=email_app
MYSQL_PASSWORD=your-mysql-password
