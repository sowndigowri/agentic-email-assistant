FLASK_SECRET_KEY=replace-with-a-random-secret
FLASK_DEBUG=True

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

TWILIO_ACCOUNT_SID=your-twilio-account-sid
